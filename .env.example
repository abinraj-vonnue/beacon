# Local application development from the host. Docker Compose configures
# DATABASE_URL separately for containers, using the database service name.
PORT=3000
DATABASE_URL=postgresql://beacon:password@localhost:5432/beacon
LOG_LEVEL=info


# Docker Compose PostgreSQL credentials
POSTGRES_DB=beacon
POSTGRES_USER=beacon
POSTGRES_PASSWORD=change-me-local-only

# Leave blank until the API logs identify Nginx's actual socket peer IP.
TRUSTED_PROXY_IP=
